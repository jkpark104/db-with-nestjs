{
  "name": "graphql-with-nestjs",
  "version": "0.0.1",
  "description": "GraphQL lecture suite — scenario-based learning over NestJS monorepo",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:users-subgraph": "nest build users-subgraph",
    "build:orders-subgraph": "nest build orders-subgraph",
    "build:gateway": "nest build gateway",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start lecture",
    "start:dev": "nest start lecture --watch",
    "start:users": "nest start users-subgraph --watch",
    "start:orders": "nest start orders-subgraph --watch",
    "start:gateway": "nest start gateway --watch",
    "start:web": "vite --config apps/web/vite.config.ts",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:contract": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.contract.config.ts",
    "test:compat": "node scripts/run-oasdiff.mjs",
    "swagger:export": "ts-node -r tsconfig-paths/register scripts/export-swagger.ts",
    "gen:types": "node scripts/gen-types.mjs",
    "mock:start": "prism mock contracts/openapi.yaml --port 4010",
    "prebuild": "pnpm gen:types",
    "pretest": "pnpm gen:types"
  },
  "dependencies": {
    "@apollo/gateway": "^2.9.3",
    "@apollo/server": "^4.11.2",
    "@apollo/subgraph": "^2.9.3",
    "@as-integrations/express5": "^1.1.2",
    "@faker-js/faker": "^10.4.0",
    "@nestjs/apollo": "^13.0.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/graphql": "^13.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.2",
    "@tanstack/react-query": "^5.100.5",
    "ajv": "^8.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dataloader": "^2.2.3",
    "graphql": "^16.9.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^5.16.2",
    "js-yaml": "^4.1.1",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@stoplight/prism-cli": "^5.15.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "openapi-response-validator": "^12.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.3.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@app/mock-data(|/.*)$": "<rootDir>/libs/mock-data/src/$1",
      "^@contracts/generated$": "<rootDir>/contracts/generated/be-types.ts",
      "^@contracts/(.*)$": "<rootDir>/contracts/$1"
    }
  }
}
